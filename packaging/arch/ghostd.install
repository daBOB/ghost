# pacman's sysusers, tmpfiles and udev hooks only run after the
# transaction, and the key below is the ghost group's to read, so the
# accounts are created here first. The units are left disabled, as on any
# Arch package.
post_install() {
  systemd-sysusers ghostauth.conf ghostd.conf

  # The host's identity (gdp-spec.md section 2.3): a self-signed certificate
  # ghostd's lobby presents and spectre pins on first use. Generated once and
  # never replaced -- a new one makes every client that trusted this host
  # warn that its certificate changed -- so it is not part of the package.
  # The key is readable by the ghost group only; ghostd, which runs as that
  # user, is its one reader.
  dir=/etc/ghost
  crt=$dir/host-cert.pem
  key=$dir/host-key.pem
  if [ -e "$crt" ] || [ -e "$key" ]; then
    [ -e "$key" ] && chgrp ghost "$key" && chmod 0640 "$key"
  else
    host=$(hostname -f 2>/dev/null || hostname)
    echo "ghostd: generating a self-signed host certificate for $host"
    install -d -m 0755 "$dir"
    if ( umask 077 && openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:P-256 \
            -sha256 -nodes -days 36500 -subj "/CN=$host" \
            -addext "subjectAltName=DNS:$host" -keyout "$key" -out "$crt" 2>/dev/null ); then
      chmod 0640 "$key"
      chgrp ghost "$key"
      chmod 0644 "$crt"
      openssl x509 -in "$crt" -noout -fingerprint -sha256
    else
      rm -f "$crt" "$key"
      echo "ghostd: certificate generation failed; create $crt and $key by hand" >&2
    fi
  fi

  if [ "$2" = "" ]; then
    echo "ghostd: enable it with"
    echo "  systemctl enable --now ghostauth.socket ghostseat.socket ghostd"
  fi
}

post_upgrade() {
  post_install "$1" "$2"
}
